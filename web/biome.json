{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "ignoreUnknown": true, "includes": ["**", "!dist", "!package-lock.json", "!public"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "noLabelWithoutControl": { "level": "error", "options": { "inputComponents": ["Input", "Checkbox"] } } },
      "complexity": { "noImportantStyles": "off" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "asNeeded" } },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": "off",
          "security": "off",
          "suspicious": { "noArrayIndexKey": "off", "noDocumentCookie": "off" },
          "correctness": { "useExhaustiveDependencies": "off", "noComponentHookFactories": "off" }
        }
      }
    }
  ]
}
